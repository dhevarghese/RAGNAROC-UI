      given-names: Hui
    - family-names: Marinov
      given-names: Toma
    - family-names: Sarkar
      given-names: Aakash
    - family-names: Bowman
      given-names: Howard
  journal: Psychological Review
  year: 2020
  volume: 127
  issue: 6
  start: 1163
  end: 1198
  doi: 10.1037/rev0000245
